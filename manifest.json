{
  "manifest_version": 3,
  "name": "GitHub Tweaks",
  "version": "1.3.0",
  "description": "Image lightbox gallery and uncapped Actions workflow graph on GitHub.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "github-tweaks.css"
      ],
      "js": [
        "lightbox.js"
      ],
      "run_at": "document_start"
    }
  ]
}
